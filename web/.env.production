# ─── API Configuration ──────────────────────────────────────────────
# IMPORTANT: Since Laravel is in the 'api' folder, the URL depends on your cPanel setup.
# If you didn't change document roots, it's usually:
VITE_API_BASE_URL=https://iaims.alyaherp.com/api/public/api/v1
# (If you made 'api' a subdomain or tweaked htaccess, it might just be: https://iaims.alyaherp.com/api/v1)

VITE_API_TIMEOUT=15000

# ─── App Identity ───────────────────────────────────────────────────
VITE_APP_NAME=IAIMS
VITE_APP_FULL_NAME="Integrated Agriculture Information Management System"
VITE_APP_VERSION=1.0.0
VITE_APP_ORG="Amhara Bureau of Agriculture"
VITE_APP_VENDOR="Alyah Technologies"

# ─── Environment ────────────────────────────────────────────────────
VITE_APP_ENV=production

# ─── Feature Flags ──────────────────────────────────────────────────
VITE_FEATURE_OFFLINE_SYNC=true
VITE_FEATURE_MERA_DASHBOARD=true
VITE_FEATURE_SMS_NOTIFICATIONS=true

# ─── Map / GIS ──────────────────────────────────────────────────────
VITE_DEFAULT_MAP_CENTER_LAT=11.5742
VITE_DEFAULT_MAP_CENTER_LNG=37.8500
VITE_DEFAULT_MAP_ZOOM=8

# ─── Session ────────────────────────────────────────────────────────
VITE_SESSION_TIMEOUT_MINUTES=30
VITE_TOKEN_REFRESH_BUFFER_SECONDS=300